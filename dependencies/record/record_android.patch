+  fun react(config: RecordConfig, event: EnvironmentEvent): List<PolicyAction> {
+    // An interruption can change the physical source or format. I/Q must be
+    // opened and validated again rather than automatically resuming.
+    if (config.isIqStream) {
+      return if (event == EnvironmentEvent.FocusLost) listOf(PolicyAction.Stop) else emptyList()
+    }
+    return when (event) {
+      EnvironmentEvent.FocusLost ->
+        if (config.audioInterruption != AudioInterruption.NONE) listOf(PolicyAction.Pause)
+        else emptyList()
 
