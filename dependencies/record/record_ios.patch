+  private func initIqSession(config: RecordConfig) throws {
+    let session = AVAudioSession.sharedInstance()
+    guard let device = config.device, !device.id.isEmpty else {
+      throw RecorderError.error(message: "iq_audio_device_unavailable", details: "Select a stereo audio input.")
+    }
+    guard !config.autoGain, !config.echoCancel, !config.noiseSuppress else {
+      throw RecorderError.error(message: "iq_audio_invalid_format", details: "I/Q capture cannot use voice processing.")
+    }
+    do {
+      if m_manageAudioSession {
+        // Measurement mode avoids voice processing. Negotiate the rate
+        // on the selected route, without the ordinary 48 kHz clamp.
+        try session.setCategory(.playAndRecord, mode: .measurement, options: [.mixWithOthers])
+        try session.setActive(true)
+      }
+      guard let selected = session.availableInputs?.first(where: { $0.uid == device.id }) else {
+        throw RecorderError.error(message: "iq_audio_device_unavailable", details: "The selected input is no longer connected.")
+      }
+      try session.setPreferredInput(selected)
+      if m_manageAudioSession { try session.setPreferredSampleRate(Double(config.sampleRate)) }
+      guard session.currentRoute.inputs.count == 1,
+            session.currentRoute.inputs.first?.uid == device.id else {
+        throw RecorderError.error(message: "iq_audio_device_unavailable", details: "The system did not route the selected input.")
+      }
+      guard selected.channels?.count == 2, session.maximumInputNumberOfChannels == 2,
+            session.mode == .measurement else {
+        throw RecorderError.error(message: "iq_audio_invalid_format", details: "I/Q requires two physical input channels in measurement mode.")
+      }
+      try session.setPreferredInputNumberOfChannels(2)
+      if #available(iOS 13.0, *) {
+        try session.setAllowHapticsAndSystemSoundsDuringRecording(false)
+      }
+    } catch {
+      if m_manageAudioSession { try? session.setActive(false, options: .notifyOthersOnDeactivation) }
+      throw error
+    }
+  }
+
+  private func validateIq(config: RecordConfig, engine: AVAudioEngine, format: AVAudioFormat) throws {
+    let session = AVAudioSession.sharedInstance()
+    let route = session.currentRoute.inputs.count == 1 ? session.currentRoute.inputs.first : nil
+    var processing = session.mode != .measurement
+    if #available(iOS 13.0, *) { processing = processing || engine.inputNode.isVoiceProcessingEnabled }
+    if let failure = IqCaptureValidation.failure(
+      selectedDeviceId: config.device?.id,
+      routedDeviceId: route?.uid,
+      physicalChannels: route?.channels?.count,
+      sessionChannels: session.inputNumberOfChannels,
+      sourceChannels: format.channelCount,
+      sessionSampleRate: session.sampleRate,
+      sourceSampleRate: format.sampleRate,
+      requestedSampleRate: config.sampleRate,
+      voiceProcessing: processing
+    ) {
+      throw RecorderError.error(message: failure, details: "The selected route must provide unchanged stereo samples at the requested rate.")
+    }
+  }
+
+  private func observeIqRoute(engine: AVAudioEngine, generation: Int) {
+    for (name, object) in [
+      (AVAudioSession.routeChangeNotification, nil as AnyObject?),
+      (AVAudioSession.interruptionNotification, nil as AnyObject?),
+      (AVAudioSession.mediaServicesWereLostNotification, nil as AnyObject?),
+      (AVAudioSession.mediaServicesWereResetNotification, nil as AnyObject?),
+      (Notification.Name.AVAudioEngineConfigurationChange, engine as AnyObject?),
+    ] {
+      m_routeObservers.append(NotificationCenter.default.addObserver(forName: name, object: object, queue: nil) { [weak self, weak engine] _ in
+        guard let self, let engine else { return }
+        self.invalidateIq(generation: generation, engine: engine)
+      })
+    }
+  }
+
+  private func invalidateIq(generation: Int, engine: AVAudioEngine? = nil) {
+    let first = m_lock.withLock { () -> Bool in
+      guard !m_iqInvalidated, generation == m_captureGeneration else { return false }
+      m_iqInvalidated = true
+      return true
+    }
+    guard first else { return }
+    m_queue.async { [weak self, weak engine] in
+      guard let self, self.m_lock.withLock({ generation == self.m_captureGeneration }) else { return }
+      if let engine, self.m_audioEngine !== engine { return }
+      self.stop()
     }
