+HRESULT ValidateIqDevice(const RecordConfig& config)
+{
+	if (config.deviceId.empty()) return kIqDeviceUnavailable;
+	IMMDeviceEnumerator* pEnumerator = NULL;
+	IMMDevice*           pDevice     = NULL;
+	IPropertyStore*      pProps      = NULL;
+
+	HRESULT hr = CoCreateInstance(
+		__uuidof(MMDeviceEnumerator), NULL,
+		CLSCTX_ALL, IID_PPV_ARGS(&pEnumerator)
+	);
+
+	if (SUCCEEDED(hr))
+	{
+		auto deviceId = Utf16FromUtf8(config.deviceId);
+		hr = deviceId.empty() ? kIqDeviceUnavailable : pEnumerator->GetDevice(deviceId.c_str(), &pDevice);
+	}
+
+	if (SUCCEEDED(hr))
+		hr = pDevice->OpenPropertyStore(STGM_READ, &pProps);
+
+	if (SUCCEEDED(hr))
+	{
+		PROPVARIANT varFormat;
+		PropVariantInit(&varFormat);
+
+		hr = pProps->GetValue(kAudioEngineDeviceFormat, &varFormat);
+		if (SUCCEEDED(hr) && varFormat.vt == VT_BLOB &&
+		    varFormat.blob.cbSize >= sizeof(WAVEFORMATEX) && varFormat.blob.pBlobData)
+		{
+			auto* wf = reinterpret_cast<const WAVEFORMATEX*>(varFormat.blob.pBlobData);
+			hr = ValidateIqSource(wf->nChannels, wf->nSamplesPerSec, config.sampleRate);
+		}
+		else
+		{
+			hr = kIqInvalidFormat;
+		}
+
+		PropVariantClear(&varFormat);
+	}
+
+	SafeRelease(&pProps);
+	SafeRelease(&pDevice);
+	SafeRelease(&pEnumerator);
+
+	// I/Q must prove its source format; guessing can mirror or mislabel RF.
+	return hr;
+}
