{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2020"],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "types": ["node"],
    "paths": {
      "@ham2k/halo-extension-sdk": ["./sdk/src/index.ts"]
    }
  },
  "include": ["sdk/src/**/*.ts", "shared/**/*.ts", "activities/*/src/**/*.ts", "contests/*/src/**/*.ts", "core/*/src/**/*.ts", "lookups/*/src/**/*.ts", "sync/*/src/**/*.ts"]
}
