{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2020"],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "paths": {
      "@ham2k/polo-sdk": ["./sdk/src/index.ts"]
    }
  },
  "include": ["sdk/src/**/*.ts", "activities/*/src/**/*.ts", "core/*/src/**/*.ts", "lookups/*/src/**/*.ts", "sync/*/src/**/*.ts"]
}
