node_modules/
.wrangler/
.orca/

# Flutter / Dart
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
build/
*.iml
.idea/
# Xcode writes these into whatever package it builds, including the vendored
# copies under packages/, whose whole value is being byte-identical to what
# pub.dev published (see their PATCH.md).
.swiftpm/

# Generated plugin bundles (built from plugins/ by `npm run build`)
app/assets/extensions/

# macOS
.DS_Store

# Local environment
.env
mise.local.toml
app/macos/Runner/Configs/Local.xcconfig
app/ios/Flutter/Local.xcconfig
scratch*
SCRATCH*
Scratch*

# Stray keys?
*_key
*.pub
*.pem
*.ppk
*.cer
*.keystore
# …but the WinSparkle update-signing PUBLIC key is meant to ship in the app
# (embedded as the DSAPub resource, like macOS's SUPublicEDKey in Info.plist).
!app/windows/runner/dsa_pub.pem
*.p12

# Dev data sandboxes (HALO_DEV_DATA, DEVELOPMENT.md): scratch log databases,
# never a checkout's to keep. A glob rather than the one documented name —
# running two sandboxes side by side is the point, and the second one is
# named by whoever starts it.
/.halo-dev-data*/
