<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET"/>
    <!-- The optional KX3 panadapter captures a selected stereo audio input. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO"/>
    <uses-feature android:name="android.hardware.microphone" android:required="false"/>
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION"/>
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION"/>
    <!-- BLE peer transport (HALO-342). `neverForLocation` keeps the scan
         permission from dragging location consent back in on 12+; the two
         legacy entries cover API 24-30, where scanning instead leans on the
         fine-location permission above. -->
    <uses-permission android:name="android.permission.BLUETOOTH" android:maxSdkVersion="30"/>
    <uses-permission android:name="android.permission.BLUETOOTH_ADMIN" android:maxSdkVersion="30"/>
    <uses-permission android:name="android.permission.BLUETOOTH_SCAN" android:usesPermissionFlags="neverForLocation"/>
    <uses-permission android:name="android.permission.BLUETOOTH_ADVERTISE"/>
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT"/>
    <uses-feature android:name="android.hardware.bluetooth_le" android:required="false"/>
    <!-- CAT over a USB-serial radio interface (usb_serial plugin). Not
         `required` — a tablet/phone without USB host still installs, it
         just won't offer serial ports. -->
    <uses-feature android:name="android.hardware.usb.host" android:required="false"/>
    <application
        android:label="${appLabel}"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:label="${appIconLabel}"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <category android:name="android.intent.category.BROWSABLE"/>
                <!-- Only THIS edition's schemes (${editionScheme}, set per
                     flavor in build.gradle.kts), so com.ham2k.halo.<edition>
                     names exactly one installed app. PoLo's com.ham2k.polo*
                     are deliberately NOT claimed: a claim here would make this
                     app a candidate for a link meant for PoLo (HALO-526). -->
                <!-- Public api, any Ham2K app: /qso, /vfo, /link_client. -->
                <data android:scheme="com.ham2k"/>
                <!-- Official HaLo prefix. -->
                <data android:scheme="com.ham2k.logger"/>
                <data android:scheme="com.ham2k.logger.${editionScheme}"/>
                <data android:scheme="com.ham2k.logger.auth"/>
                <!-- Load-bearing literal: SOTA's Keycloak client holds this
                     exact string on its redirect allowlist, and a spelling it
                     does not hold fails sign-in at the provider
                     (ham2k/halo-dist#253). -->
                <data android:scheme="com.ham2k.logger.${editionScheme}.auth"/>
                <!-- Aliases under HaLo's own name. Nothing outside this app
                     emits one, which is what makes com.ham2k.halo.<edition> a
                     clean "is that edition installed?" probe — the official
                     family cannot serve, since a build older than HALO-526
                     claims every edition's. -->
                <data android:scheme="com.ham2k.halo"/>
                <data android:scheme="com.ham2k.halo.${editionScheme}"/>
                <data android:scheme="com.ham2k.halo.${editionScheme}.auth"/>
            </intent-filter>
            <!-- Ham2K extension bundles (HALO-422), so a .h2kext opened from
                 Files or a browser download offers this app.

                 Two filters because Android matches either the MIME type OR
                 the path, never reliably both: a provider that knows the type
                 sends application/zip and says nothing useful about the name,
                 while a file:// URI carries the name and usually no type at
                 all. What was actually opened is decided by the bundle's magic
                 bytes, exactly as for a picked file. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <category android:name="android.intent.category.BROWSABLE"/>
                <data android:mimeType="application/vnd.ham2k.extension"/>
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <category android:name="android.intent.category.BROWSABLE"/>
                <data android:scheme="content"/>
                <data android:scheme="file"/>
                <data android:host="*"/>
                <data android:mimeType="*/*"/>
                <data android:pathPattern=".*\\.h2kext"/>
            </intent-filter>
            <!-- Puts HaLo in Android's "open with" chooser when a matching
                 USB-serial adapter is plugged in — see res/xml/device_filter.xml
                 for which chips. -->
            <intent-filter>
                <action android:name="android.hardware.usb.action.USB_DEVICE_ATTACHED"/>
            </intent-filter>
            <meta-data
                android:name="android.hardware.usb.action.USB_DEVICE_ATTACHED"
                android:resource="@xml/device_filter"/>
        </activity>
        <!-- The image the Operation Postcard last copied, for the app that
             pastes it (ImageClipboardChannel.kt). Not exported: the clipboard
             grants the reader access to the one URI it holds. -->
        <provider
            android:name=".ClipboardImageProvider"
            android:authorities="${applicationId}.clipboard_image"
            android:exported="false"
            android:grantUriPermissions="true" />
        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
        <!-- The other Ham2K loggers, so onboarding can offer to link this
             device against an account one of them already holds (HALO-526).
             Android 11+ filters package queries: without a <package> entry
             here, getPackageInfo throws NameNotFoundException for an app that
             IS installed, and the offer never appears. Every edition is
             listed because this manifest is templated per flavor and cannot
             know which one it is building; the running package always
             resolves, so it is excluded in Dart, not here. -->
        <package android:name="com.ham2k.polo.prod"/>
        <package android:name="com.ham2k.polo.beta"/>
        <package android:name="com.ham2k.polo.alpha"/>
        <package android:name="com.ham2k.logger.prod"/>
        <package android:name="com.ham2k.logger.next"/>
        <package android:name="com.ham2k.logger.dev"/>
    </queries>
</manifest>
