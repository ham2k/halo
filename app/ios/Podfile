platform :ios, '15.0'

# CocoaPods analytics sends network stats synchronously affecting flutter build latency.
ENV['COCOAPODS_DISABLE_STATS'] = 'true'

project 'Runner', {
  'Debug' => :debug,
  'Profile' => :release,
  'Release' => :release,
}

def flutter_root
  generated_xcode_build_settings_path = File.expand_path(File.join('..', 'Flutter', 'Generated.xcconfig'), __FILE__)
  unless File.exist?(generated_xcode_build_settings_path)
    raise "#{generated_xcode_build_settings_path} must exist. If you're running pod install manually, make sure flutter pub get is executed first"
  end

  File.foreach(generated_xcode_build_settings_path) do |line|
    matches = line.match(/FLUTTER_ROOT\=(.*)/)
    return matches[1].strip if matches
  end
  raise "FLUTTER_ROOT not found in #{generated_xcode_build_settings_path}. Try deleting Generated.xcconfig, then run flutter pub get"
end

require File.expand_path(File.join('packages', 'flutter_tools', 'bin', 'podhelper'), flutter_root)

flutter_ios_podfile_setup

target 'Runner' do
  use_frameworks!

  flutter_install_all_ios_pods File.dirname(File.realpath(__FILE__))
  target 'RunnerTests' do
    inherit! :search_paths
  end
end

post_install do |installer|
  # The Pods project carries the `platform :ios` floor declared above; it is
  # what a pod inherits when it declares no deployment target of its own.
  floor = installer.pods_project.build_configurations.first.build_settings['IPHONEOS_DEPLOYMENT_TARGET']
  raise "The Pods project declares no IPHONEOS_DEPLOYMENT_TARGET; is `platform :ios` still in this Podfile?" if floor.nil?

  # The app project declares the same floor for itself, and nothing but this
  # compares the two: with the Podfile above the project, the pods target an OS
  # the app does not require, and the app ships declaring the lower minimum.
  installer.aggregate_targets.flat_map(&:user_targets).uniq.each do |user_target|
    user_target.build_configurations.each do |config|
      declared = config.resolve_build_setting('IPHONEOS_DEPLOYMENT_TARGET')
      next if declared == floor
      raise "#{user_target.name} (#{config.name}) has IPHONEOS_DEPLOYMENT_TARGET #{declared.inspect}, but the Podfile's `platform :ios` says #{floor}; they must agree."
    end
  end

  installer.pods_project.targets.each do |target|
    flutter_additional_ios_build_settings(target)

    # Flutter's helper leaves a pod's own deployment target in place from 13.0
    # up — its own `Flutter` pod among them — and Xcode refuses to build a
    # target below its supported range. Raise only: a pod that needs MORE than
    # the floor keeps its value, so that incompatibility still errors.
    target.build_configurations.each do |config|
      declared = config.build_settings['IPHONEOS_DEPLOYMENT_TARGET']
      next if declared.nil? || Gem::Version.new(declared) >= Gem::Version.new(floor)
      config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] = floor
    end
  end
end
