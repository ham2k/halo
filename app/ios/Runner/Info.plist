<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CADisableMinimumFrameDurationOnPhone</key>
	<true/>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleDisplayName</key>
	<string>$(HALO_DISPLAY_NAME)</string>
	<!-- Ham2K extension bundles (HALO-422). The exported type declaration is
	     what teaches the OS the extension exists at all; the document type is
	     what makes Finder offer this app for one. Both are needed, and a
	     double-clicked file still only reaches Flutter because AppDelegate
	     implements application(_:open:) — app_links handles URL schemes only. -->
	<key>UTExportedTypeDeclarations</key>
	<array>
		<dict>
			<key>UTTypeIdentifier</key>
			<string>com.ham2k.extension-bundle</string>
			<key>UTTypeDescription</key>
			<string>Ham2K Extension</string>
			<key>UTTypeConformsTo</key>
			<array>
				<!-- It IS a zip, so anything that reads one can still open it. -->
				<string>public.zip-archive</string>
			</array>
			<key>UTTypeTagSpecification</key>
			<dict>
				<key>public.filename-extension</key>
				<array>
					<string>h2kext</string>
				</array>
				<key>public.mime-type</key>
				<array>
					<string>application/vnd.ham2k.extension</string>
				</array>
			</dict>
		</dict>
	</array>
	<key>CFBundleDocumentTypes</key>
	<array>
		<dict>
			<key>CFBundleTypeName</key>
			<string>Ham2K Extension</string>
			<key>LSItemContentTypes</key>
			<array>
				<string>com.ham2k.extension-bundle</string>
			</array>
			<!-- Viewer, not Editor: the app installs a bundle, it does not
			     write one back. -->
			<key>CFBundleTypeRole</key>
			<string>Viewer</string>
			<key>LSHandlerRank</key>
			<string>Owner</string>
		</dict>
	</array>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>com.ham2k.halo.deeplinks</string>
			<!-- Only THIS edition's schemes, in both families, so
			     com.ham2k.halo.<edition> names exactly one installed app. A
			     build that claims a sibling's scheme makes canOpenURL answer
			     yes for an edition that isn't there, which is what the
			     sibling-app offer reads (HALO-526). PoLo's own
			     com.ham2k.polo* are deliberately NOT claimed: they are
			     queried below, and a claim would answer our own query. -->
			<key>CFBundleURLSchemes</key>
			<array>
				<!-- Public api, any Ham2K app: /qso, /vfo, /link_client. -->
				<string>com.ham2k</string>
				<!-- Official HaLo prefix. -->
				<string>com.ham2k.logger</string>
				<string>com.ham2k.logger.$(HALO_EDITION)</string>
				<string>com.ham2k.logger.auth</string>
				<!-- Load-bearing literal: SOTA's Keycloak client holds this
				     exact string on its redirect allowlist, and a spelling it
				     does not hold fails sign-in before any redirect happens
				     (ham2k/halo-dist#253). -->
				<string>com.ham2k.logger.$(HALO_EDITION).auth</string>
				<!-- Aliases under HaLo's own name. Nothing outside this app
				     emits one, which is what makes com.ham2k.halo.<edition> a
				     clean "is that edition installed?" probe — the official
				     family cannot serve, since a build older than HALO-526
				     claims every edition's. -->
				<string>com.ham2k.halo</string>
				<string>com.ham2k.halo.$(HALO_EDITION)</string>
				<string>com.ham2k.halo.$(HALO_EDITION).auth</string>
			</array>
		</dict>
	</array>
	<!-- What canOpenURL may ask about (asking, not claiming — see
	     HALO-526). Every edition is listed because this plist is templated
	     per edition and cannot know which one it is building; the running
	     edition always answers yes about itself, so it is excluded in Dart,
	     not here. -->
	<key>LSApplicationQueriesSchemes</key>
	<array>
		<string>com.ham2k.polo</string>
		<string>com.ham2k.halo.dev</string>
		<string>com.ham2k.halo.next</string>
		<string>com.ham2k.halo.prod</string>
	</array>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(HALO_BUNDLE_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(FLUTTER_BUILD_NAME)</string>
	<key>CFBundleSignature</key>
	<string>????</string>
	<key>CFBundleVersion</key>
	<string>$(FLUTTER_BUILD_NUMBER)</string>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<key>NSBluetoothAlwaysUsageDescription</key>
	<string>Used to control your radio through a Bluetooth LE interface, and to find and sync with your own paired devices when peer device sync is on and no shared network is available.</string>
	<key>NSMicrophoneUsageDescription</key>
	<string>Used to display your KX3 panadapter from the stereo audio input you select. Capture starts only while its spectrum is open.</string>
	<key>NSLocationWhenInUseUsageDescription</key>
	<string>Used to suggest nearby activities (parks, summits), set the operation's grid square, and — when peer device sync is on — share your position with your own paired devices.</string>
	<key>UIApplicationSceneManifest</key>
	<dict>
		<key>UIApplicationSupportsMultipleScenes</key>
		<false/>
		<key>UISceneConfigurations</key>
		<dict>
			<key>UIWindowSceneSessionRoleApplication</key>
			<array>
				<dict>
					<key>UISceneClassName</key>
					<string>UIWindowScene</string>
					<key>UISceneConfigurationName</key>
					<string>flutter</string>
					<key>UISceneDelegateClassName</key>
					<string>$(PRODUCT_MODULE_NAME).SceneDelegate</string>
					<key>UISceneStoryboardFile</key>
					<string>Main</string>
				</dict>
			</array>
		</dict>
	</dict>
	<key>UIApplicationSupportsIndirectInputEvents</key>
	<true/>
	<key>UILaunchStoryboardName</key>
	<string>LaunchScreen</string>
	<key>UIMainStoryboardFile</key>
	<string>Main</string>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<!-- Export compliance: the app uses only standard, exempt encryption
	     (HTTPS/TLS and the OS keychain), so it declares no non-exempt
	     encryption. Clears App Store Connect's per-build
	     MISSING_EXPORT_COMPLIANCE gate. Revisit if custom crypto is added. -->
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<!-- "Listen for other apps" (HALO-306) binds a UDP socket to hear N1MM
	     Logger+/WSJT-X on the local network — iOS gates ANY local-subnet
	     traffic behind this prompt since iOS 14. -->
	<key>NSLocalNetworkUsageDescription</key>
	<string>Ham2K Logger finds your other devices on this network to share an operation's log with them, listens for QSOs logged in other programs like N1MM Logger+ and WSJT-X, and finds radios on this network when you add equipment. None of this happens until you turn it on or ask for it.</string>
	<!-- The service types the Add Equipment dialog browses for
	     (AppDelegate.swift's BonjourBrowser). iOS refuses to browse a type
	     not listed here, silently: the browse simply finds nothing. -->
	<key>NSBonjourServices</key>
	<array>
		<string>_sotacat._tcp</string>
	</array>
</dict>
</plist>
