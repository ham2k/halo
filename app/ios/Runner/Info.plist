		</dict>
		<dict>
			<key>CFBundleTypeName</key>
			<string>QSON Operation</string>
			<key>LSItemContentTypes</key>
			<array>
				<string>com.ham2k.qson</string>
			</array>
			<key>CFBundleTypeRole</key>
			<string>Viewer</string>
			<key>LSHandlerRank</key>
			<string>Alternate</string>
		</dict>
		<dict>
			<key>CFBundleTypeName</key>
			<string>ADIF Log</string>
			<key>LSItemContentTypes</key>
			<array>
				<string>org.adif.adif</string>
			</array>
			<key>CFBundleTypeRole</key>
			<string>Viewer</string>
			<key>LSHandlerRank</key>
			<string>Alternate</string>
		</dict>
	</array>
	<!-- iOS hands the app a copy of an opened document rather than the
	     original: an import reads it once and never writes it back.
	     AppDelegate removes the copy once it has taken its own. -->
	<key>LSSupportsOpeningDocumentsInPlace</key>
	<false/>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>com.ham2k.halo.deeplinks</string>
			<!-- Only THIS edition's schemes, in both families, so
			     com.ham2k.halo.<edition> names exactly one installed app. A
			     build that claims a sibling's scheme makes canOpenURL answer
			     yes for an edition that isn't there, which is what the
			     sibling-app offer reads (HALO-526). PoLo's own
			     com.ham2k.polo* are deliberately NOT claimed: they are
			     queried below, and a claim would answer our own query. -->
			<key>CFBundleURLSchemes</key>
			<array>
				<!-- Public api, any Ham2K app: /qso, /vfo, /link_client. -->
				<string>com.ham2k</string>
				<!-- Official HaLo prefix. -->
				<string>com.ham2k.logger</string>
				<string>com.ham2k.logger.$(HALO_EDITION)</string>
				<string>com.ham2k.logger.auth</string>
				<!-- Load-bearing literal: SOTA's Keycloak client holds this
				     exact string on its redirect allowlist, and a spelling it
				     does not hold fails sign-in before any redirect happens
				     (ham2k/halo-dist#253). -->
				<string>com.ham2k.logger.$(HALO_EDITION).auth</string>
				<!-- Aliases under HaLo's own name. Nothing outside this app
				     emits one, which is what makes com.ham2k.halo.<edition> a
				     clean "is that edition installed?" probe — the official
				     family cannot serve, since a build older than HALO-526
				     claims every edition's. -->
				<string>com.ham2k.halo</string>
				<string>com.ham2k.halo.$(HALO_EDITION)</string>
				<string>com.ham2k.halo.$(HALO_EDITION).auth</string>
			</array>
		</dict>
	</array>
	<!-- What canOpenURL may ask about (asking, not claiming — see
	     HALO-526). Every edition is listed because this plist is templated
	     per edition and cannot know which one it is building; the running
	     edition always answers yes about itself, so it is excluded in Dart,
	     not here. -->
	<key>LSApplicationQueriesSchemes</key>
	<array>
		<string>com.ham2k.polo</string>
		<string>com.ham2k.halo.dev</string>
		<string>com.ham2k.halo.next</string>
		<string>com.ham2k.halo.prod</string>
	</array>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(HALO_BUNDLE_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(FLUTTER_BUILD_NAME)</string>
	<key>CFBundleSignature</key>
	<string>????</string>
	<key>CFBundleVersion</key>
	<string>$(FLUTTER_BUILD_NUMBER)</string>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<key>NSBluetoothAlwaysUsageDescription</key>
