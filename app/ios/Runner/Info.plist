<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CADisableMinimumFrameDurationOnPhone</key>
	<true/>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleDisplayName</key>
	<string>$(HALO_DISPLAY_NAME)</string>
	<!-- FOLLOWUP: the edition schemes are hardwired here because iOS has no
	     HALO_EDITION build setting yet (editions PR #140 covers core + macOS
	     only). Once editions reach iOS, replace the .dev/.next entries with a
	     single com.ham2k.logger.$(HALO_EDITION), as macOS already does. -->
	<!-- Ham2K extension bundles (HALO-422). The exported type declaration is
	     what teaches the OS the extension exists at all; the document type is
	     what makes Finder offer this app for one. Both are needed, and a
	     double-clicked file still only reaches Flutter because AppDelegate
	     implements application(_:open:) — app_links handles URL schemes only. -->
	<key>UTExportedTypeDeclarations</key>
	<array>
		<dict>
			<key>UTTypeIdentifier</key>
			<string>com.ham2k.extension-bundle</string>
			<key>UTTypeDescription</key>
			<string>Ham2K Extension</string>
			<key>UTTypeConformsTo</key>
			<array>
				<!-- It IS a zip, so anything that reads one can still open it. -->
				<string>public.zip-archive</string>
			</array>
			<key>UTTypeTagSpecification</key>
			<dict>
				<key>public.filename-extension</key>
				<array>
					<string>h2kext</string>
				</array>
				<key>public.mime-type</key>
				<array>
					<string>application/vnd.ham2k.extension</string>
				</array>
			</dict>
		</dict>
	</array>
	<key>CFBundleDocumentTypes</key>
	<array>
		<dict>
			<key>CFBundleTypeName</key>
			<string>Ham2K Extension</string>
			<key>LSItemContentTypes</key>
			<array>
				<string>com.ham2k.extension-bundle</string>
			</array>
			<!-- Viewer, not Editor: the app installs a bundle, it does not
			     write one back. -->
			<key>CFBundleTypeRole</key>
			<string>Viewer</string>
			<key>LSHandlerRank</key>
			<string>Owner</string>
		</dict>
	</array>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>com.ham2k.logger.deeplinks</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>com.ham2k</string>
				<string>com.ham2k.logger</string>
				<string>com.ham2k.logger.dev</string>
				<string>com.ham2k.logger.next</string>
				<string>com.ham2k.logger.auth</string>
				<!-- SOTA's per-edition OAuth clients (ham2k/halo-dist#253) —
				     all three listed for the same FOLLOWUP reason as .dev/.next
				     above: no per-edition Info.plist here yet, so every build
				     carries every edition's scheme. -->
				<string>com.ham2k.logger.prod.auth</string>
				<string>com.ham2k.logger.next.auth</string>
				<string>com.ham2k.logger.dev.auth</string>
				<string>com.ham2k.polo</string>
				<string>com.ham2k.polo.auth</string>
			</array>
		</dict>
	</array>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(HALO_BUNDLE_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(FLUTTER_BUILD_NAME)</string>
	<key>CFBundleSignature</key>
	<string>????</string>
	<key>CFBundleVersion</key>
	<string>$(FLUTTER_BUILD_NUMBER)</string>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<key>NSBluetoothAlwaysUsageDescription</key>
	<string>Used to find and sync with your own paired devices over Bluetooth when peer device sync is on and no shared network is available.</string>
	<key>NSLocationWhenInUseUsageDescription</key>
	<string>Used to suggest nearby activities (parks, summits), set the operation's grid square, and — when peer device sync is on — share your position with your own paired devices.</string>
	<key>UIApplicationSceneManifest</key>
	<dict>
		<key>UIApplicationSupportsMultipleScenes</key>
		<false/>
		<key>UISceneConfigurations</key>
		<dict>
			<key>UIWindowSceneSessionRoleApplication</key>
			<array>
				<dict>
					<key>UISceneClassName</key>
					<string>UIWindowScene</string>
					<key>UISceneConfigurationName</key>
					<string>flutter</string>
					<key>UISceneDelegateClassName</key>
					<string>$(PRODUCT_MODULE_NAME).SceneDelegate</string>
					<key>UISceneStoryboardFile</key>
					<string>Main</string>
				</dict>
			</array>
		</dict>
	</dict>
	<key>UIApplicationSupportsIndirectInputEvents</key>
	<true/>
	<key>UILaunchStoryboardName</key>
	<string>LaunchScreen</string>
	<key>UIMainStoryboardFile</key>
	<string>Main</string>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<!-- Export compliance: the app uses only standard, exempt encryption
	     (HTTPS/TLS and the OS keychain), so it declares no non-exempt
	     encryption. Clears App Store Connect's per-build
	     MISSING_EXPORT_COMPLIANCE gate. Revisit if custom crypto is added. -->
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<!-- "Listen for other apps" (HALO-306) binds a UDP socket to hear N1MM
	     Logger+/WSJT-X on the local network — iOS gates ANY local-subnet
	     traffic behind this prompt since iOS 14, regardless of whether the
	     app also advertises a Bonjour service (it doesn't, so no
	     NSBonjourServices entry is needed alongside this). -->
	<key>NSLocalNetworkUsageDescription</key>
	<string>Ham2K Logger finds your other devices on this network to share an operation's log with them, and listens for QSOs logged in other programs like N1MM Logger+ and WSJT-X. Both are off until you turn them on.</string>
</dict>
</plist>
