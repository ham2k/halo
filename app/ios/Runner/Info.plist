<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CADisableMinimumFrameDurationOnPhone</key>
	<true/>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleDisplayName</key>
	<string>$(HALO_DISPLAY_NAME)</string>
	<!-- FOLLOWUP: the edition schemes are hardwired here because iOS has no
	     HALO_EDITION build setting yet (editions PR #140 covers core + macOS
	     only). Once editions reach iOS, replace the .dev/.next entries with a
	     single com.ham2k.logger.$(HALO_EDITION), as macOS already does. -->
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>com.ham2k.logger.deeplinks</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>com.ham2k</string>
				<string>com.ham2k.logger</string>
				<string>com.ham2k.logger.dev</string>
				<string>com.ham2k.logger.next</string>
				<string>com.ham2k.logger.auth</string>
				<!-- SOTA's per-edition OAuth clients (ham2k/halo-dist#253) —
				     all three listed for the same FOLLOWUP reason as .dev/.next
				     above: no per-edition Info.plist here yet, so every build
				     carries every edition's scheme. -->
				<string>com.ham2k.logger.prod.auth</string>
				<string>com.ham2k.logger.next.auth</string>
				<string>com.ham2k.logger.dev.auth</string>
				<string>com.ham2k.polo</string>
				<string>com.ham2k.polo.auth</string>
			</array>
		</dict>
	</array>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(HALO_BUNDLE_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(FLUTTER_BUILD_NAME)</string>
	<key>CFBundleSignature</key>
	<string>????</string>
	<key>CFBundleVersion</key>
	<string>$(FLUTTER_BUILD_NUMBER)</string>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<key>NSLocationWhenInUseUsageDescription</key>
	<string>Used to suggest nearby activities (parks, summits) and set the operation's grid square.</string>
	<key>UIApplicationSceneManifest</key>
	<dict>
		<key>UIApplicationSupportsMultipleScenes</key>
		<false/>
		<key>UISceneConfigurations</key>
		<dict>
			<key>UIWindowSceneSessionRoleApplication</key>
			<array>
				<dict>
					<key>UISceneClassName</key>
					<string>UIWindowScene</string>
					<key>UISceneConfigurationName</key>
					<string>flutter</string>
					<key>UISceneDelegateClassName</key>
					<string>$(PRODUCT_MODULE_NAME).SceneDelegate</string>
					<key>UISceneStoryboardFile</key>
					<string>Main</string>
				</dict>
			</array>
		</dict>
	</dict>
	<key>UIApplicationSupportsIndirectInputEvents</key>
	<true/>
	<key>UILaunchStoryboardName</key>
	<string>LaunchScreen</string>
	<key>UIMainStoryboardFile</key>
	<string>Main</string>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<!-- Export compliance: the app uses only standard, exempt encryption
	     (HTTPS/TLS and the OS keychain), so it declares no non-exempt
	     encryption. Clears App Store Connect's per-build
	     MISSING_EXPORT_COMPLIANCE gate. Revisit if custom crypto is added. -->
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<!-- "Listen for other apps" (HALO-306) binds a UDP socket to hear N1MM
	     Logger+/WSJT-X on the local network — iOS gates ANY local-subnet
	     traffic behind this prompt since iOS 14, regardless of whether the
	     app also advertises a Bonjour service (it doesn't, so no
	     NSBonjourServices entry is needed alongside this). -->
	<key>NSLocalNetworkUsageDescription</key>
	<string>Ham2K Logger listens for QSOs logged in other programs like N1MM Logger+ and WSJT-X on your local network, when you turn that on in an operation's Imports panel.</string>
</dict>
</plist>
