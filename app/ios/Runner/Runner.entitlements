<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- WSJT-X's own UDP protocol defaults to a multicast destination (see
	     "Listen for other apps", HALO-306). This is a RESTRICTED
	     entitlement Apple grants case-by-case on request
	     (https://developer.apple.com/contact/request/networking-multicast) —
	     present here is necessary but not sufficient: a Release/TestFlight/
	     App Store build still needs Apple's approval on file for the signing
	     identity, or multicast joins fail on real hardware. The Simulator
	     does not enforce this, so it tests clean either way. -->
	<key>com.apple.developer.networking.multicast</key>
	<true/>
</dict>
</plist>
