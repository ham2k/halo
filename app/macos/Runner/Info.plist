<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIconFile</key>
	<string></string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>com.ham2k.logger.deeplinks</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>com.ham2k</string>
				<string>com.ham2k.logger</string>
				<string>com.ham2k.logger.$(HALO_EDITION)</string>
				<string>com.ham2k.logger.auth</string>
				<!-- SOTA's per-edition OAuth client (ham2k/halo-dist#253) —
				     must match the redirect URL registered with THIS edition's
				     Keycloak client. -->
				<string>com.ham2k.logger.$(HALO_EDITION).auth</string>
				<string>com.ham2k.polo</string>
				<string>com.ham2k.polo.auth</string>
			</array>
		</dict>
	</array>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(FLUTTER_BUILD_NAME)</string>
	<key>CFBundleVersion</key>
	<string>$(FLUTTER_BUILD_NUMBER)</string>
	<key>LSMinimumSystemVersion</key>
	<string>$(MACOSX_DEPLOYMENT_TARGET)</string>
	<key>NSHumanReadableCopyright</key>
	<string>$(PRODUCT_COPYRIGHT)</string>
	<key>NSLocationUsageDescription</key>
	<string>Used to suggest nearby activities (parks, summits), set the operation's grid square, and — when peer device sync is on — share your position with your own paired devices.</string>
	<key>NSMainNibFile</key>
	<string>MainMenu</string>
	<key>NSPrincipalClass</key>
	<string>NSApplication</string>
	<key>SUPublicEDKey</key>
	<string>VLtiaqyGxaQ/3F44wFqN0zZ4Nul5aDNZ8XQxYMGJx/c=</string>
	<key>SUFeedURL</key>
	<string>https://updates.ham2k.net/halo-$(HALO_EDITION)/macos/appcast.xml</string>
	<key>SUEnableAutomaticChecks</key>
	<true/>
	<!-- This build is sandboxed, so Sparkle can't swap the .app from inside the
	     sandbox directly — it must hand the install to its Installer Launcher
	     XPC service, which runs outside the sandbox. Without this the update
	     downloads and verifies but fails at install with "An error occurred
	     while launching the installer". Pairs with the
	     temporary-exception.mach-lookup.global-name entitlement (Release.entitlements)
	     that lets the sandbox reach the `<bundle-id>-spks`/`-spki` services.
	     We keep network.client, so the separate Downloader XPC isn't needed. -->
	<key>SUEnableInstallerLauncherService</key>
	<true/>
	<!-- macOS 15 gates local-network access behind a consent prompt, and a
	     build with no reason string shows a bare, alarming one. Two features
	     reach the LAN: capturing QSOs from N1MM+/WSJT-X (HALO-306) and peer
	     device sync (HALO-310). Both are opt-in and neither is reachable
	     without the operator turning it on first. -->
	<key>NSLocalNetworkUsageDescription</key>
	<string>Ham2K Logger finds your other devices on this network to share an operation's log with them, and listens for QSOs logged in other programs like N1MM Logger+ and WSJT-X. Both are off until you turn them on.</string>
</dict>
</plist>
