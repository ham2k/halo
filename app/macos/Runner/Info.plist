<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIconFile</key>
	<string></string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<!-- Ham2K extension bundles (HALO-422). The exported type declaration is
	     what teaches the OS the extension exists at all; the document type is
	     what makes Finder offer this app for one. Both are needed, and a
	     double-clicked file still only reaches Flutter because AppDelegate
	     implements application(_:open:) — app_links handles URL schemes only. -->
	<key>UTExportedTypeDeclarations</key>
	<array>
		<dict>
			<key>UTTypeIdentifier</key>
			<string>com.ham2k.extension-bundle</string>
			<key>UTTypeDescription</key>
			<string>Ham2K Extension</string>
			<key>UTTypeConformsTo</key>
			<array>
				<!-- It IS a zip, so anything that reads one can still open it. -->
				<string>public.zip-archive</string>
			</array>
			<key>UTTypeTagSpecification</key>
			<dict>
				<key>public.filename-extension</key>
				<array>
					<string>h2kext</string>
				</array>
				<key>public.mime-type</key>
				<array>
					<string>application/vnd.ham2k.extension</string>
				</array>
			</dict>
		</dict>
	</array>
	<key>CFBundleDocumentTypes</key>
	<array>
		<dict>
			<key>CFBundleTypeName</key>
			<string>Ham2K Extension</string>
			<key>LSItemContentTypes</key>
			<array>
				<string>com.ham2k.extension-bundle</string>
			</array>
			<!-- Viewer, not Editor: the app installs a bundle, it does not
			     write one back. -->
			<key>CFBundleTypeRole</key>
			<string>Viewer</string>
			<key>LSHandlerRank</key>
			<string>Owner</string>
		</dict>
	</array>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>com.ham2k.halo.deeplinks</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<!-- Public api, any Ham2K app: /qso, /vfo, /link_client. -->
				<string>com.ham2k</string>
				<!-- Official HaLo prefix. -->
				<string>com.ham2k.logger</string>
				<string>com.ham2k.logger.$(HALO_EDITION)</string>
				<string>com.ham2k.logger.auth</string>
				<!-- SOTA's per-edition OAuth client (ham2k/halo-dist#253) —
				     must match the redirect URL registered with THIS edition's
				     Keycloak client, as a literal. -->
				<string>com.ham2k.logger.$(HALO_EDITION).auth</string>
				<!-- Aliases under HaLo's own name; the per-edition one is what
				     sibling detection probes (HALO-526). -->
				<string>com.ham2k.halo</string>
				<string>com.ham2k.halo.$(HALO_EDITION)</string>
				<string>com.ham2k.halo.$(HALO_EDITION).auth</string>
			</array>
		</dict>
	</array>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(FLUTTER_BUILD_NAME)</string>
	<key>CFBundleVersion</key>
	<string>$(FLUTTER_BUILD_NUMBER)</string>
	<key>LSMinimumSystemVersion</key>
	<string>$(MACOSX_DEPLOYMENT_TARGET)</string>
	<key>NSBluetoothAlwaysUsageDescription</key>
	<string>Used to control your radio through a Bluetooth LE interface, and to find and sync with your own paired devices when peer device sync is on and no shared network is available.</string>
	<key>NSHumanReadableCopyright</key>
	<string>$(PRODUCT_COPYRIGHT)</string>
	<key>NSLocationUsageDescription</key>
	<string>Used to suggest nearby activities (parks, summits), set the operation's grid square, and — when peer device sync is on — share your position with your own paired devices.</string>
	<key>NSMainNibFile</key>
	<string>MainMenu</string>
	<key>NSMicrophoneUsageDescription</key>
	<string>Ham2K Logger reads your selected stereo audio input to display the spectrum from your radio's I/Q output.</string>
	<key>NSPrincipalClass</key>
	<string>NSApplication</string>
	<key>SUPublicEDKey</key>
	<string>VLtiaqyGxaQ/3F44wFqN0zZ4Nul5aDNZ8XQxYMGJx/c=</string>
	<key>SUFeedURL</key>
	<string>https://updates.ham2k.net/halo-$(HALO_EDITION)/macos/appcast.xml</string>
	<key>SUEnableAutomaticChecks</key>
	<true/>
	<!-- This build is sandboxed, so Sparkle can't swap the .app from inside the
	     sandbox directly — it must hand the install to its Installer Launcher
	     XPC service, which runs outside the sandbox. Without this the update
	     downloads and verifies but fails at install with "An error occurred
	     while launching the installer". Pairs with the
	     temporary-exception.mach-lookup.global-name entitlement (Release.entitlements)
	     that lets the sandbox reach the `<bundle-id>-spks`/`-spki` services.
	     We keep network.client, so the separate Downloader XPC isn't needed. -->
	<key>SUEnableInstallerLauncherService</key>
	<true/>
	<!-- macOS 15 gates local-network access behind a consent prompt, and a
	     build with no reason string shows a bare, alarming one. Three features
	     reach the LAN: capturing QSOs from N1MM+/WSJT-X, peer device sync,
	     and equipment discovery while the Add Equipment dialog is open. None
	     runs without the operator asking. -->
	<key>NSLocalNetworkUsageDescription</key>
	<string>Ham2K Logger finds your other devices on this network to share an operation's log with them, listens for QSOs logged in other programs like N1MM Logger+ and WSJT-X, and finds radios on this network when you add equipment. None of this happens until you turn it on or ask for it.</string>
</dict>
</plist>
