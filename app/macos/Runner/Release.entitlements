<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>com.apple.security.app-sandbox</key>
	<true/>
	<!-- The extension runtime uses JavaScriptCore, which JITs, so the hardened
	     runtime needs allow-jit (arm64 JSC uses MAP_JIT) + allow-unsigned-
	     executable-memory. Neither is a restricted entitlement. Matches Debug. -->
	<key>com.apple.security.cs.allow-jit</key>
	<true/>
	<key>com.apple.security.cs.allow-unsigned-executable-memory</key>
	<true/>
	<key>com.apple.security.files.user-selected.read-write</key>
	<true/>
	<key>com.apple.security.network.client</key>
	<true/>
	<!-- GATO equipment discovery binds a UDP port to receive the broadcasts
	     radios make about themselves (FlexRadio announces on 4992). Binding
	     a listening socket needs network.server, NOT just network.client.
	     This had been in DebugProfile.entitlements only, which meant
	     discovery would have worked in every development build and failed
	     silently in the shipped, signed app. Like network.client and the
	     temporary-exception keys below, this is a SANDBOX relaxation, not
	     one of the AMFI-restricted entitlements warned about at the bottom
	     of this file — it needs no provisioning profile and does not affect
	     spawning. Still: verify discovery on a SIGNED Release build, since
	     Debug will pass regardless. -->
	<key>com.apple.security.network.server</key>
	<true/>
	<key>com.apple.security.personal-information.location</key>
	<true/>
	<!-- GATO opens a serial port for CAT (the FT-891's built-in USB-to-serial
	     bridge, and most other rigs). Like network.client above this is a
	     SANDBOX relaxation, not one of the AMFI-restricted entitlements
	     warned about below — no provisioning profile, no effect on spawning.
	     Still: verify against a real port on a SIGNED Release build, since
	     Debug passes regardless. -->
	<key>com.apple.security.device.serial</key>
	<true/>
	<!-- BLE peer transport (HALO-342). A sandbox relaxation like
	     device.serial above, not AMFI-restricted. Must be present in BOTH
	     entitlement files — a Release-only miss is the documented trap. -->
	<key>com.apple.security.device.bluetooth</key>
	<true/>
	<key>com.apple.security.device.audio-input</key>
	<true/>
	<!-- Sparkle installs updates from OUTSIDE the sandbox via its Installer
	     Launcher XPC service (enabled by SUEnableInstallerLauncherService in
	     Info.plist). App Sandbox blocks global Mach-service lookup by default, so
	     the sandboxed app must be granted lookup of Sparkle's two installer
	     services or the update fails at install ("An error occurred while
	     launching the installer"). Sparkle names them `<host-bundle-id>-spks`
	     and `-spki`. Unlike keychain-access-groups below, these
	     `temporary-exception.*` keys are SANDBOX relaxations evaluated by the
	     sandbox — NOT AMFI-restricted — so they need no provisioning profile and
	     don't affect spawning. NOTE: the $(PRODUCT_BUNDLE_IDENTIFIER) token is
	     substituted by Xcode for the initial build sign; the CI re-sign
	     (app_dist/ci/build-macos.sh) does NOT expand it, so it swaps in the
	     concrete per-edition bundle id before signing the app. -->
	<key>com.apple.security.temporary-exception.mach-lookup.global-name</key>
	<array>
		<string>$(PRODUCT_BUNDLE_IDENTIFIER)-spks</string>
		<string>$(PRODUCT_BUNDLE_IDENTIFIER)-spki</string>
	</array>
	<!-- DO NOT add `keychain-access-groups` or `cs.disable-library-validation`
	     here: both are RESTRICTED entitlements that AMFI only validates against a
	     provisioning profile. A Developer ID direct-distribution build has none,
	     so either one makes the app fail to SPAWN — amfid logs "Restricted
	     entitlements not validated ... No matching profile found" and RunningBoard
	     reports "Launchd job spawn failed" (POSIX 163). The keychain-access-groups
	     array was empty/unused anyway; a sandboxed app already gets its own
	     keychain access group. -->
</dict>
</plist>
