// Application-level settings for the Runner target.
//
// This may be replaced with something auto-generated from metadata (e.g., pubspec.yaml) in the
// future. If not, the values below would default to using the project name when this becomes a
// 'flutter create' template.

// The application's name — drives the Dock/Finder icon label, the app
// menu (top-left), and the About/Quit menu items (MainMenu.xib's "APP_NAME"
// placeholders are substituted by AppKit at nib-load time using this name).
PRODUCT_NAME = Ham2K Logger

// The application's bundle identifier
PRODUCT_BUNDLE_IDENTIFIER = com.ham2k.logger

// The copyright displayed in application information
PRODUCT_COPYRIGHT = Copyright © 2026 com.ham2k. All rights reserved.

// Optional signing overrides (DEVELOPMENT_TEAM, CODE_SIGN_IDENTITY).
// Distribution repos commit theirs under app_dist/, which does not exist
// in public checkouts; Local.xcconfig is a gitignored per-developer
// override that wins over both — see Local.xcconfig.sample and README.md
// "Building locally on macOS".
#include? "../../../../app_dist/macos/Signing.xcconfig"
#include? "Local.xcconfig"
